    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const body = pm.response.json();",
          "pm.test(\"공통 응답 JSON\", () => {",
          "    pm.expect(body).to.have.all.keys(\"success\", \"data\", \"error\");",
          "    pm.expect(body.success).to.eql(pm.response.code < 400);",
          "    if (body.success) {",
          "        pm.expect(body.error).to.eql(null);",
          "    } else {",
          "        pm.expect(body.data).to.eql(null);",
          "        pm.expect(body.error.fields).to.be.an(\"array\");",
          "    }",
          "});",
          "if (pm.response.code >= 400) {",
          "  const codes = {400:\"INVALID_REQUEST\",404:\"RESOURCE_NOT_FOUND\",409:\"CONFLICT\"};",
          "  if (codes[pm.response.code]) pm.test(\"공통 오류 코드\", () => pm.expect(body.error.code).to.eql(codes[pm.response.code]));",
          "}"
        ]
      }
    }
  ],
