{
  "info": {
    "name": "TEAMNOTE 팀장 API",
    "description": "프로젝트와 공통 Markdown 검증. 폴더 순서대로 로컬 서버에 실행하며, 삭제 제한 검증에 필요한 업무·회의만 생성해 정리합니다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8080"
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "const body = pm.response.json();",
          "pm.test(\"공통 응답 JSON\", () => {",
          "    pm.expect(body).to.have.all.keys(\"success\", \"data\", \"error\");",
          "    pm.expect(body.success).to.eql(pm.response.code < 400);",
          "    if (body.success) {",
          "        pm.expect(body.error).to.eql(null);",
          "    } else {",
          "        pm.expect(body.data).to.eql(null);",
          "        pm.expect(body.error.fields).to.be.an(\"array\");",
          "    }",
          "});"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Markdown 미리보기",
      "item": [
        {
          "name": "표가 포함된 Markdown 미리보기",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"헤더와 표 렌더링\", () => { const html = pm.response.json().data.html; pm.expect(html).to.include(\"<h1>TEAMNOTE</h1>\"); pm.expect(html).to.include(\"<table>\"); });",
                  "if (pm.response.code === 200) { pm.collectionVariables.set(\"leaderPreviewHtml\", pm.response.json().data.html); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/content/preview",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"markdown\": \"# TEAMNOTE\\n\\n| 담당 | 작업 |\\n| --- | --- |\\n| 팀장 | 프로젝트 |\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "빈 Markdown 미리보기",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"빈 HTML\", () => { pm.expect(pm.response.json().data.html).to.eql(\"\"); });"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
