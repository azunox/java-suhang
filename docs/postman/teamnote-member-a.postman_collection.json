        "body": {
          "mode": "raw",
          "raw": "{\"name\": \"A 업무 API 검증\", \"descriptionMarkdown\": \"# 검증용 프로젝트\", \"startDate\": \"2026-11-09\", \"endDate\": \"2026-11-30\", \"status\": \"IN_PROGRESS\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test(\"공통 응답\", () => pm.expect(body.success).to.eql(true));",
