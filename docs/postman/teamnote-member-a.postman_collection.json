{
  "info": {
    "name": "TEAMNOTE 팀원 A 업무 API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "업무 담당 자료. 준비 단계의 프로젝트 POST는 업무 테스트 데이터 생성용이다. 팀장·B API 검증을 대신하지 않는다. 로컬 메모리 H2 전용 실행을 권장한다."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:18081"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (!pm.collectionVariables.get(\"today\")) {",
          "  const day = 86400000; const now = Date.now() + 9 * 3600000;",
          "  for (const [key, offset] of [[\"yesterday\",-1],[\"today\",0],[\"tomorrow\",1]]) {",
          "    pm.collectionVariables.set(key, new Date(now + offset * day).toISOString().slice(0,10));",
          "  }",
          "}"
        ]
      }
    }
  ],
